{
  "$schema": "https://opencode.ai/config.json",
  
  "provider": {
	"localOllama": {
	  "name": "Local Ollama",
	  "npm": "@ai-sdk/openai-compatible",
	  "options": { "baseURL": "http://localhost:11434/v1"	},
	  "models": {
		"lfm2.5:latest": {
			"name": "Liquid -LFM2.5",
			"tools": true,
			"reasoning": true	},
		"gemma4:e2b": {
			"name": "Gemma 4",
			"tools": true,
			"reasoning": true	}
		}
	},
    "remoteOllama": {
      "name": "Ollama Remote",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://ac-containervm:11434/v1" },
      "models": {
        "nemotron-3-nano:30b": {	
			"name": "Nemotron-3-Nano",
			"tools": true,
			"reasoning": true },
        "qwen3-coder:30b": {	
			"name": "Qwen3 Coder",
			"tools": true,
			"reasoning": true },
		"gemma4:31b": {
			"name": "Gemma4",
			"tools": true,
		"reasoning": true }
      }
    }
  }
}
